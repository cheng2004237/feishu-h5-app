# 飞书应用凭证（在飞书开放平台 https://open.feishu.cn 获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格配置
# BITABLE_APP_TOKEN: 打开多维表格，URL 中 /base/ 后面那段字符串
BITABLE_APP_TOKEN=bascxxxxxxxxxxxxxxxxxxxxxxxx

# BITABLE_TABLE_ID: 点击表名旁的 ... 菜单 -> 复制链接，URL 中 table= 后面那段字符串
BITABLE_TABLE_ID=tblxxxxxxxxxxxxxxxx